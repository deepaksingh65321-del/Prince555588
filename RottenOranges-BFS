import java.util.*;

class Solution
{
    static class Cell
    {
        int row,col,time;
        Cell(int r, int c,int t)
        {
            row=r;
            col=c;
            time=t;
        }
    }
    public int orangesRotting(int[][] grid)
    {
        int rows = grid.length;
        int cols = grid[0].length;
        
        Queue<Cell> q = new LinkedList<>();
        int freshCount=0;
        //1. Collect all initially rotten oranges and count fresh
        for(int i=0, i < rows; i++)
        {
            for(int j=0 , j< cols; j++)
            {
                if(grid[i][j] == 2)
                {
                    q.offer(new Cell(row,col,0)); // time 0
                }
                else if(grid[i][j] == 1)
                {
                    freshCount++;
                }
            }
        }
        // If no fresh oranges, answer is 0
        if(freshCount == 0)
        {
            return 0;
        }
         int maxTime = 0;
         
         // 4-direction vectors
         
         int[] dr = {-1,1,0,0};
         int[] dc = {0,0,-1,1};
         
         //2. BFS
         while(!q.isEmpty())
         {
             Cell curr=q.poll();
           int r =  curr.row;
           int c =  curr.col;
           int t =  curr.time;
             
         }
         
         maxTime = Math.max(maxTime,t);
         
         for(int i=0;i<4;i++)
         {
             int nr = r+dr[i];
             int nc = c+dc[i];
             
             // boundary check
             if(nr<0 || nr>=rows || nc<0 || nc>=cols)
             {
                 continue;
             }
             
             // only spread to fresh oranges
             if(grid[nr][nc] == 1)
             {
                 grid[nr][nc] = 2; // now rotten
                 freshCount--;
                 q.offer(new Cell(nr,nc,t+1));
             }
         }
       
       //3. If some fresh oranges remain, impossible
       if(freshCount > 0)
       {
           return -1
       }
        
        
        return maxTime;
        //Time Complexity: O(R*C)
        //Space Complexity: O(R*C)
        
    }
    
}
