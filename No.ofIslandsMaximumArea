// We have a grid of 0s(water) and 1s(land). An island = group of //connected 1s(connected vertically or horizontally)
//Find the maximum area(count of 1-cells) in any island.
class Solution
{
    public int maxAreaOfIsland(int[][] grid)
    {
        int maxArea=0;
        
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]==1)
                {
                    int area=dfs(grid,i,j);
                    maxArea=Math.max(area,maxArea);
                }
            }
        }
        return maxArea;
    }
    //Top down recursive approach
    private int dfs(int[][] grid,int r,int c)
    {
       //boundary or water
       if(r<0 || c<0 || r>=grid.length || c>=grid[0].length || grid[r][c]==0)
       {
           return 0;
       }
       //If already visited Mark as Visited
       grid[r][c]=0;
       int area=1;
       area+=dfs(grid,r-1,c);
       area+=dfs(grid,r+1,c);
       area+=dfs(grid,r,c-1);
       area+=dfs(grid,r,c+1);
       return area;
       //Time Complexity: O(R*C);
       //Space Complexity: O(R*C)
    }
}
