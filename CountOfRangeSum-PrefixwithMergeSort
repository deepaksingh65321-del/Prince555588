class Solution {
    public int countRangeSum(int[] nums, int lower, int upper) {
        long[] prefix = new long[nums.length+1];
        for(int i=0;i<nums.length;i++)
        {
            prefix[i+1]=prefix[i]+nums[i];
        }
        return mergeSort(prefix,0,prefix.length-1,lower,upper);
        //Need to do merge sorting divide & Conquer rule
    }

   private int mergeSort(long[] arr,int left,int right,int lower,int upper)
   {
        if(left>=right)
        {
            return 0;
        }

        int mid = (left + right) / 2;
        int count=0;

        //Using Merge Sort & it is using Recursion
        //Spliting into two parts--> left to mid && mid+1 to right
        count += mergeSort(arr,left,mid,lower,upper);
        count += mergeSort(arr,mid+1,right,lower,upper);

        int j=mid+1 , k=mid+1;

        for(int i = left;i<=mid;i++)
        {
            while(k<=right && arr[k]-arr[i] < lower)
            {
                k++;
            }

            while(j<=right && arr[j]-arr[i] <= upper)
            {
                j++;
            }

            count+= (j-k);
        }

        Arrays.sort(arr,left,right+1);
        return count;
   }

}
